<style>
  .search-btn{
    background-color:  #fe424d;
    color: #ffffff;
    border-radius: 25px;
    padding : 0 1rem 0 1rem;
  }
  .search-btn:hover{
    background-color:  #fe424d;
    color: #ffffff;
